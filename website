<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#080808">
<meta name="description" content="DO IT Clothing – Streetwear, Schuhe, Hosen, Jacken, Caps & Mützen.">
<title>DO IT® — Clothing</title>

<style>
:root{
  --bg:#070707;
  --card:#101010;
  --text:#f4f4f2;
  --muted:#8c8c8c;
  --line:#242424;
  --white:#fff;
  --max:1400px;
}

*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

html{
  scroll-behavior:smooth;
}

body{
  background:var(--bg);
  color:var(--text);
  font-family:Arial,Helvetica,sans-serif;
  overflow-x:hidden;
}

button,input{
  font:inherit;
}

button{
  cursor:pointer;
}

a{
  color:inherit;
  text-decoration:none;
}

.container{
  width:min(var(--max),92%);
  margin:auto;
}

/* ================= LOADER ================= */

.loader{
  position:fixed;
  inset:0;
  background:#000;
  z-index:9999;
  display:grid;
  place-items:center;
  transition:.7s;
}

.loader.hide{
  opacity:0;
  visibility:hidden;
}

.loader-mark{
  font-size:clamp(3rem,15vw,9rem);
  font-weight:900;
  letter-spacing:-.08em;
}

.loader-mark span{
  display:inline-block;
  animation:pop .8s ease both;
}

.loader-mark span:nth-child(2){
  animation-delay:.08s;
}

.loader-mark span:nth-child(3){
  animation-delay:.16s;
}

.loader-mark span:nth-child(4){
  animation-delay:.24s;
}

@keyframes pop{
  from{
    transform:translateY(25px);
    opacity:0;
  }

  to{
    transform:none;
    opacity:1;
  }
}

/* ================= HEADER ================= */

.header{
  position:fixed;
  top:0;
  left:0;
  right:0;
  z-index:1000;
  padding:18px 0;
  transition:.3s;
}

.header.scrolled{
  background:rgba(7,7,7,.88);
  backdrop-filter:blur(16px);
  border-bottom:1px solid var(--line);
}

.nav{
  display:flex;
  align-items:center;
  justify-content:space-between;
}

.icon-btn{
  width:44px;
  height:44px;
  border:1px solid transparent;
  background:transparent;
  color:white;
  border-radius:50%;
  display:grid;
  place-items:center;
}

.icon-btn:hover{
  border-color:#444;
  background:#111;
}

.logo-small{
  font-weight:900;
  font-size:1.25rem;
  letter-spacing:-.07em;
}

.logo-small span{
  font-size:.55rem;
  letter-spacing:.22em;
  display:block;
  text-align:center;
  margin-top:-2px;
}

.right-actions{
  display:flex;
  align-items:center;
  gap:4px;
}

.bag-count{
  position:absolute;
  top:7px;
  right:4px;
  background:#fff;
  color:#000;
  border-radius:50%;
  font-size:9px;
  width:16px;
  height:16px;
  display:grid;
  place-items:center;
  font-weight:800;
}

.bag-wrap{
  position:relative;
}

/* ================= HERO ================= */

.hero{
  min-height:100svh;
  display:flex;
  align-items:center;
  justify-content:center;
  position:relative;
  padding:100px 20px 60px;
  background:
    radial-gradient(
      circle at center,
      #151515 0,
      #070707 48%,
      #000 100%
    );
}

.hero:after{
  content:"";
  position:absolute;
  inset:0;
  background:linear-gradient(
    transparent 75%,
    #070707
  );
}

.hero-logo{
  width:min(720px,78vw);
  max-height:68vh;
  object-fit:contain;
  mix-blend-mode:screen;
  filter:contrast(1.05);
}

.hero-copy{
  position:absolute;
  bottom:30px;
  left:0;
  right:0;
  text-align:center;
  z-index:2;
  text-transform:uppercase;
  font-size:10px;
  letter-spacing:.3em;
  color:#aaa;
}

.scroll-line{
  width:1px;
  height:55px;
  background:#777;
  margin:14px auto 0;
  animation:pulse 1.8s infinite;
}

@keyframes pulse{
  50%{
    opacity:.2;
    transform:scaleY(.65);
  }
}

/* ================= INTRO ================= */

.intro{
  padding:130px 0 100px;
  border-top:1px solid var(--line);
}

.kicker{
  text-transform:uppercase;
  color:#777;
  font-size:10px;
  letter-spacing:.28em;
  margin-bottom:22px;
}

.intro h1{
  font-size:clamp(3rem,9vw,8.5rem);
  line-height:.88;
  letter-spacing:-.075em;
  max-width:1000px;
}

.intro p{
  max-width:570px;
  color:#aaa;
  line-height:1.7;
  margin:35px 0 0;
  font-size:1rem;
}

/* ================= STORY ================= */

.story{
  padding:100px 0;
  border-top:1px solid var(--line);
}

.story-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:50px;
  align-items:end;
}

.story h2{
  font-size:clamp(2.5rem,7vw,7rem);
  line-height:.9;
  letter-spacing:-.07em;
}

.story-text{
  color:#aaa;
  line-height:1.8;
  max-width:520px;
}

.story-text strong{
  color:#fff;
}

/* ================= SHOP ================= */

.shop{
  padding:110px 0;
  border-top:1px solid var(--line);
}

.shop-head{
  display:flex;
  justify-content:space-between;
  gap:20px;
  align-items:end;
  margin-bottom:30px;
}

.shop-head h2{
  font-size:clamp(3rem,8vw,7rem);
  letter-spacing:-.07em;
  line-height:.85;
}

.filters{
  display:flex;
  gap:8px;
  overflow:auto;
  padding-bottom:8px;
  margin-bottom:28px;
}

.filter{
  border:1px solid #333;
  background:transparent;
  color:#aaa;
  padding:11px 15px;
  border-radius:100px;
  white-space:nowrap;
}

.filter.active,
.filter:hover{
  background:#fff;
  color:#000;
  border-color:#fff;
}

.gender{
  display:flex;
  gap:8px;
  margin-bottom:30px;
}

.gender button{
  border:0;
  background:#151515;
  color:#aaa;
  padding:10px 14px;
  border-radius:5px;
}

.gender button.active{
  background:#fff;
  color:#000;
}

.products{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:12px;
}

.product{
  background:#101010;
  border:1px solid #1d1d1d;
  position:relative;
  overflow:hidden;
  transition:.35s;
}

.product:hover{
  transform:translateY(-5px);
  border-color:#444;
}

.product-img{
  aspect-ratio:4/5;
  background:#171717;
  display:grid;
  place-items:center;
  overflow:hidden;
}

.product-img img{
  width:100%;
  height:100%;
  object-fit:cover;
  transition:.5s;
}

.product:hover .product-img img{
  transform:scale(1.04);
}

.placeholder{
  font-size:10px;
  letter-spacing:.2em;
  color:#555;
  text-transform:uppercase;
}

.product-info{
  padding:16px;
}

.brand{
  font-size:10px;
  color:#777;
  text-transform:uppercase;
  letter-spacing:.16em;
}

.product-name{
  font-weight:700;
  margin-top:6px;
}

.meta{
  display:flex;
  justify-content:space-between;
  color:#777;
  font-size:11px;
  margin-top:10px;
}

.price{
  font-weight:800;
  color:#fff;
}

.heart{
  position:absolute;
  top:12px;
  right:12px;
  border:0;
  background:rgba(0,0,0,.65);
  color:#fff;
  border-radius:50%;
  width:36px;
  height:36px;
}

.add{
  width:100%;
  border:1px solid #333;
  background:#fff;
  color:#000;
  padding:11px;
  margin-top:13px;
  font-weight:800;
  text-transform:uppercase;
  font-size:10px;
  letter-spacing:.1em;
}

.empty{
  grid-column:1/-1;
  padding:60px;
  text-align:center;
  color:#777;
  border:1px dashed #333;
}

/* ================= FOOTER ================= */

.footer{
  padding:90px 0 35px;
  border-top:1px solid var(--line);
}

.footer-grid{
  display:grid;
  grid-template-columns:2fr 1fr 1fr 1fr;
  gap:40px;
}

.footer h3{
  font-size:2rem;
  letter-spacing:-.05em;
}

.footer p,
.footer a{
  color:#888;
  line-height:2;
  display:block;
}

.footer a:hover{
  color:#fff;
}

.copyright{
  border-top:1px solid var(--line);
  margin-top:60px;
  padding-top:20px;
  color:#555;
  font-size:10px;
  display:flex;
  justify-content:space-between;
}

/* ================= MENU ================= */

.overlay{
  position:fixed;
  inset:0;
  background:rgba(0,0,0,.65);
  z-index:1900;
  opacity:0;
  visibility:hidden;
  transition:.3s;
}

.overlay.open{
  opacity:1;
  visibility:visible;
}

.drawer{
  position:fixed;
  top:0;
  left:0;
  bottom:0;
  width:min(420px,90vw);
  background:#0b0b0b;
  z-index:2000;
  transform:translateX(-100%);
  transition:.4s cubic-bezier(.7,0,.2,1);
  padding:30px;
}

.drawer.open{
  transform:none;
}

.drawer-head{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:45px;
}

.close{
  border:0;
  background:transparent;
  color:#fff;
  font-size:28px;
}

.drawer nav a{
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:18px 0;
  border-bottom:1px solid #242424;
  font-size:1.2rem;
  font-weight:700;
}

.drawer nav a small{
  font-size:10px;
  color:#666;
  letter-spacing:.15em;
}

.drawer-bottom{
  position:absolute;
  left:30px;
  right:30px;
  bottom:30px;
}

.drawer-bottom p{
  color:#777;
  font-size:12px;
  line-height:1.7;
}

/* ================= SEARCH ================= */

.search-panel{
  position:fixed;
  inset:0;
  background:#070707;
  z-index:1800;
  padding:110px 5% 50px;
  transform:translateY(-100%);
  transition:.45s;
}

.search-panel.open{
  transform:none;
}

.search-input{
  width:100%;
  border:0;
  border-bottom:1px solid #444;
  background:transparent;
  color:#fff;
  font-size:clamp(2rem,7vw,6rem);
  outline:none;
  padding:20px 0;
}

.search-hint{
  color:#666;
  margin-top:20px;
}

/* ================= CART ================= */

.cart{
  position:fixed;
  top:0;
  right:0;
  bottom:0;
  width:min(440px,92vw);
  background:#0b0b0b;
  z-index:2000;
  transform:translateX(100%);
  transition:.4s cubic-bezier(.7,0,.2,1);
  padding:28px;
}

.cart.open{
  transform:none;
}

.cart-items{
  margin-top:30px;
  display:grid;
  gap:12px;
}

.cart-item{
  display:flex;
  gap:12px;
  padding:12px;
  border:1px solid #252525;
}

.cart-item-img{
  width:70px;
  height:85px;
  background:#171717;
  object-fit:cover;
}

.cart-total{
  border-top:1px solid #333;
  margin-top:25px;
  padding-top:20px;
  display:flex;
  justify-content:space-between;
  font-weight:800;
}

.checkout{
  width:100%;
  padding:15px;
  border:0;
  background:#fff;
  color:#000;
  font-weight:900;
  margin-top:18px;
}

/* ================= LOGIN ================= */

.modal{
  position:fixed;
  inset:0;
  background:rgba(0,0,0,.75);
  z-index:2500;
  display:grid;
  place-items:center;
  opacity:0;
  visibility:hidden;
  transition:.3s;
  padding:20px;
}

.modal.open{
  opacity:1;
  visibility:visible;
}

.modal-box{
  background:#101010;
  border:1px solid #333;
  width:min(500px,100%);
  padding:30px;
}

.modal-box h2{
  font-size:2rem;
  letter-spacing:-.05em;
  margin-bottom:12px;
}

.modal-box p{
  color:#888;
  line-height:1.6;
  margin-bottom:20px;
}

.modal-box input{
  width:100%;
  background:#070707;
  border:1px solid #333;
  color:#fff;
  padding:13px;
  margin-bottom:10px;
}

.modal-box button{
  width:100%;
  padding:13px;
  border:0;
  background:#fff;
  color:#000;
  font-weight:800;
}

.modal-close{
  float:right;
  border:0;
  background:none;
  color:#fff;
  font-size:22px;
}

/* ================= RESPONSIVE ================= */

@media(max-width:900px){

  .products{
    grid-template-columns:repeat(2,1fr);
  }

  .story-grid,
  .footer-grid{
    grid-template-columns:1fr;
  }

  .shop-head{
    display:block;
  }

  .shop-head h2{
    margin-bottom:25px;
  }
}

@media(max-width:560px){

  .hero-logo{
    width:92vw;
  }

  .products{
    gap:8px;
  }

  .product-info{
    padding:12px;
  }

  .footer-grid{
    gap:30px;
  }

  .copyright{
    display:block;
    line-height:2;
  }
}
</style>
</head>

