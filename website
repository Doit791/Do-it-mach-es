  </button>

  <div class="kicker">
    Suche
  </div>

  <input
    class="search-input"
    id="searchInput"
    placeholder="Suchen..."
    oninput="renderProducts()"
  >

  <div class="search-hint">
    Suche nach Schuhen, Hosen,
    Jacken, Caps oder Mützen.
  </div>

</section>


<!-- ================= CART ================= -->

<aside
  class="cart"
  id="cart"
>

  <div class="drawer-head">

    <strong>
      Warenkorb
    </strong>

    <button
      class="close"
      onclick="closeAll()"
    >
      ×
    </button>

  </div>


  <div
    class="cart-items"
    id="cartItems"
  ></div>


  <div class="cart-total">

    <span>
      Gesamt
    </span>

    <span id="cartTotal">
      0,00 €
    </span>

  </div>


  <button
    class="checkout"
    onclick="alert('Der echte Checkout kann als nächster Schritt mit einem Zahlungsanbieter verbunden werden.')"
  >
    ZUR KASSE
  </button>

</aside>


<!-- ================= LOGIN ================= -->

<div
  class="modal"
  id="loginModal"
>

  <div class="modal-box">

    <button
      class="modal-close"
      onclick="closeAll()"
    >
      ×
    </button>

    <div class="kicker">
      DO IT® ACCOUNT
    </div>

    <h2>
      Anmelden.
    </h2>

    <p>
      Speichere deine Merkliste und
      erhalte Infos zu neuen Artikeln.
    </p>

    <input
      type="email"
      placeholder="E-Mail"
    >

    <input
      type="password"
      placeholder="Passwort"
    >

    <button
      onclick="alert('Demo: Die Anmeldung wird im nächsten Schritt mit einem echten Account-System verbunden.')"
    >
      ANMELDEN
    </button>

  </div>

</div>


<script>

/* ================= PRODUKTE ================= */

const products = [

  {
    id:1,
    brand:"Nike",
    name:"Air Force 1",
    category:"Schuhe",
    gender:"Männer",
    price:129.90,
    image:"",
    meta:"42 · Sehr gut"
  },

  {
    id:2,
    brand:"Carhartt",
    name:"Work Pant",
    category:"Hosen",
    gender:"Männer",
    price:79.90,
    image:"",
    meta:"M · Sehr gut"
  },

  {
    id:3,
    brand:"The North Face",
    name:"Puffer Jacket",
    category:"Jacken",
    gender:"Frauen",
    price:169.90,
    image:"",
    meta:"S · Sehr gut"
  },

  {
    id:4,
    brand:"New Era",
    name:"NY Cap",
    category:"Caps",
    gender:"Alle",
    price:39.90,
    image:"",
    meta:"One Size"
  },

  {
    id:5,
    brand:"Nike",
    name:"Beanie",
    category:"Mützen",
    gender:"Alle",
    price:34.90,
    image:"",
    meta:"One Size"
  },

  {
    id:6,
    brand:"Adidas",
    name:"Campus 00s",
    category:"Schuhe",
    gender:"Frauen",
    price:119.90,
    image:"",
    meta:"39 · Sehr gut"
  },

  {
    id:7,
    brand:"Levi's",
    name:"501",
    category:"Hosen",
    gender:"Frauen",
    price:69.90,
    image:"",
    meta:"W28 · Gut"
  },

  {
    id:8,
    brand:"Carhartt",
    name:"Detroit Jacket",
    category:"Jacken",
    gender:"Männer",
    price:149.90,
    image:"",
    meta:"L · Sehr gut"
  }

];


let activeFilter="Alle";
let activeGender="Alle";
let cart=[];


/* ================= PRODUKTE RENDERN ================= */

function renderProducts(){

  const q =
    (
      document.getElementById("searchInput")?.value
      || ""
    ).toLowerCase();


  const list =
    products.filter(p =>

      (
        activeFilter==="Alle"
        ||
        p.category===activeFilter
      )

      &&

      (
        activeGender==="Alle"
        ||
        p.gender===activeGender
      )

      &&

      (
        p.name
        +" "
        +p.brand
        +" "
        +p.category
      )
      .toLowerCase()
      .includes(q)

    );


  const el =
    document.getElementById("products");


  if(!list.length){

    el.innerHTML =
      '<div class="empty">Keine Artikel gefunden.</div>';

    return;
  }


  el.innerHTML =
    list.map(p => `

      <article class="product">

        <button
          class="heart"
          onclick="saveItem(${p.id})"
        >
          ♡
        </button>

        <div class="product-img">

          ${
            p.image

            ?

            `<img
              src="${p.image}"
              alt="${p.brand} ${p.name}"
            >`

            :

            `<span class="placeholder">
              ${p.category}
            </span>`
          }

        </div>


        <div class="product-info">

          <div class="brand">
            ${p.brand}
          </div>

          <div class="product-name">
            ${p.name}
          </div>

          <div class="meta">

            <span>
              ${p.meta}
            </span>

            <span class="price">
              ${p.price
                .toFixed(2)
                .replace(".",",")
              } €
            </span>

          </div>


          <button
            class="add"
            onclick="addToCart(${p.id})"
          >
            In den Warenkorb
          </button>

        </div>

      </article>

    `).join("");

}


/* ================= KATEGORIE ================= */

function setCategory(cat){

  activeFilter=cat;


  document
    .querySelectorAll(".filter")
    .forEach(b =>
      b.classList.toggle(
        "active",
        b.dataset.filter===cat
      )
    );


  renderProducts();
}


document
  .querySelectorAll(".filter")
  .forEach(
    b =>
      b.onclick =
        () =>
          setCategory(
            b.dataset.filter
          )
  );


/* ================= GESCHLECHT ================= */

document
  .querySelectorAll(".gender button")
  .forEach(
    b =>

      b.onclick = () => {

        activeGender =
          b.dataset.gender;


        document
          .querySelectorAll(".gender button")
          .forEach(
            x =>
              x.classList.toggle(
                "active",
                x===b
              )
          );


        renderProducts();

      }
  );


/* ================= WARENKORB ================= */

function addToCart(id){

  const p =
    products.find(
      x => x.id===id
    );

  cart.push(p);

  updateCart();

  openCart();
}


function updateCart(){

  document
    .getElementById("bagCount")
    .textContent =
      cart.length;


  const items =
    document.getElementById(
      "cartItems"
    );


  if(!cart.length){

    items.innerHTML =
      '<p style="color:#777">Dein Warenkorb ist leer.</p>';

  }

  else{

    items.innerHTML =
      cart.map(
        (p,i) => `

          <div class="cart-item">

            <div class="cart-item-img"></div>

            <div style="flex:1">

              <small style="color:#777">
                ${p.brand}
              </small>

              <div>
                ${p.name}
              </div>

              <strong>
                ${p.price
                  .toFixed(2)
                  .replace(".",",")
                } €
              </strong>

            </div>

            <button
              onclick="removeCart(${i})"
              style="
                background:none;
                border:0;
                color:#777;
              "
            >
              ×
            </button>

          </div>

        `
      ).join("");

  }


  document
    .getElementById("cartTotal")
    .textContent =

      cart
        .reduce(
          (a,p) => a+p.price,
          0
        )
        .toFixed(2)
        .replace(".",",")
      +" €";

}


function removeCart(i){

  cart.splice(i,1);

  updateCart();

}


/* ================= MERKLISTE ================= */

function saveItem(id){

  localStorage.setItem(
    "doit_saved",

    JSON.stringify([

      ...(
        JSON.parse(
          localStorage.getItem(
            "doit_saved"
          )
          ||
          "[]"
        )
      ),

      id

    ])
  );


  alert(
    "Artikel gemerkt. Melde dich an, um deine Merkliste dauerhaft zu speichern."
  );

}


/* ================= MENÜ ================= */

function openMenu(){

  closeAll();

  document
    .getElementById("drawer")
    .classList.add("open");

  document
    .getElementById("overlay")
    .classList.add("open");

}


/* ================= WARENKORB ÖFFNEN ================= */

function openCart(){

  closeAll();

  document
    .getElementById("cart")
    .classList.add("open");

  document
    .getElementById("overlay")
    .classList.add("open");

  updateCart();

}


/* ================= SUCHE ================= */

function openSearch(){

  closeAll();

  document
    .getElementById("searchPanel")
    .classList.add("open");


  setTimeout(

    () =>
      document
        .getElementById("searchInput")
        .focus(),

    300

  );

}


/* ================= LOGIN ================= */

function openLogin(){

  closeAll();

  document
    .getElementById("loginModal")
    .classList.add("open");

}


/* ================= SCHLIESSEN ================= */

function closeAll(){

  document
    .querySelectorAll(
      ".drawer,.cart,.search-panel,.modal,.overlay"
    )
    .forEach(
      x =>
        x.classList.remove("open")
    );

}


/* ================= HEADER SCROLL ================= */

window.addEventListener(
  "scroll",

  () =>

    document
      .getElementById("header")
      .classList.toggle(
        "scrolled",
        scrollY>30
      )

);


/* ================= LOADER ================= */

window.addEventListener(
  "load",

  () =>

    setTimeout(
      () =>
        document
          .getElementById("loader")
          .classList.add("hide"),

      700
    )

);


/* ================= START ================= */

renderProducts();

updateCart();

</script>

</body>
</html>
